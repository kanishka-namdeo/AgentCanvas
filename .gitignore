.pi/tmp/

# ---- Sandbox-only scripts' runtime artifacts ----
.zscripts/mini-service-*.log

# ---- Design-pattern memory (user-specific RAG store) ----
data/

# ---- Cloned reference repo (nested git) — do not commit ----
download/AgentCanvas/

# ---- Worklog (session-specific) ----
worklog.md

# ---- Bench artifacts (Phase 4 — scripts/dom-renderer-bench/run.ts) ----
/scripts/dom-renderer-bench/results.json

# ---- Third-party research clones (agent-durability research 2026-08-28) ----
