// Prisma schema for AgentCanvas — a Figma-like design tool where AI agents
// (driven by the Pi Agent SDK) are the primary users of the canvas.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// NOTE: In Prisma 7+, the `url` property was removed from `datasource`.
// The connection URL now lives in `prisma.config.ts`, and the PrismaClient
// constructor receives a driver adapter (`@prisma/adapter-libsql` for SQLite).
datasource db {
  provider = "sqlite"
}

/// A design document — analogous to a Figma file. Holds many shapes
/// and stores a complete revision history of agent actions.
model Document {
  id        String   @id @default(cuid())
  name      String   @default("Untitled")
  /// JSON-serialized canvas viewport (zoom, pan) at last save.
  viewport  String   @default("{}")
  /// Canvas background color (hex).
  background String  @default("#f8fafc")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shapes    Shape[]
  actions   AgentAction[]
}

/// A single visual node on the canvas — rectangle, ellipse, text, line, etc.
/// Stored as a flat list; parent/child (group) relationships are encoded
/// inside `parentId`. This mirrors Figma's node tree at a small scale.
model Shape {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Shape kind: "rectangle" | "ellipse" | "text" | "line" | "frame" | "group"
  type       String
  /// User/agent-visible name (shown in the layers panel).
  name       String
  /// Position (canvas-space, top-left origin).
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(100)
  height     Float    @default(100)
  /// Rotation in degrees.
  rotation   Float    @default(0)
  /// Opacity 0..1.
  opacity    Float    @default(1)
  /// Fill color (hex) — empty string means no fill.
  fill       String   @default("#e2e8f0")
  /// Stroke color (hex).
  stroke     String   @default("#0f172a")
  /// Stroke width in px.
  strokeWidth Float   @default(0)
  /// Border radius in px (rectangles / frames).
  radius     Float    @default(0)
  /// Text content (only for type = "text").
  text       String?
  /// Font size for text shapes.
  fontSize   Float    @default(16)
  /// Text color (hex).
  textColor  String   @default("#0f172a")
  /// Optional parent group/frame id.
  parentId   String?
  /// Stacking order — higher = drawn on top.
  zIndex     Int      @default(0)
  /// Whether the layer is locked (agent cannot mutate).
  locked     Boolean  @default(false)
  /// Whether the layer is hidden from rendering.
  visible    Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
  @@index([parentId])
}

/// Audit log of every tool call the agent made against a document.
/// Useful for replay, undo, and showing the user what the agent did.
///
/// DEPRECATED 2026-08-28: this model has had zero writers since it was added
/// (its required Document relation has no writers either — creating a row
/// would require materializing a Document first). The live journal is
/// `AgentEvent` below, written server-side from the NDJSON route. Kept for
/// schema archaeology; do not add new writers.
model AgentAction {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The Pi Agent SDK tool name, e.g. "canvas_create_shape".
  tool       String
  /// JSON-serialized arguments passed to the tool.
  arguments  String
  /// JSON-serialized result returned by the tool.
  result     String
  /// Whether the tool execution succeeded.
  success    Boolean  @default(true)
  /// Wall-clock duration of the tool call in ms.
  durationMs Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([documentId])
}

/// Append-only AGENT EVENT JOURNAL (OpenHands-style event sourcing) — the
/// server-side source of truth for what the agent did on a document.
///
/// Written from the NDJSON route (src/app/api/agent/route.ts) for EVERY
/// significant agent event: patches (with toolCallId), tool_call_start/end,
/// message_start/end, turn_end / turn_cancelled, agent:error / agent:stuck,
/// model_info, skill_selected, plan, critique. High-frequency deltas
/// (message_delta / thinking_delta / presence) are deliberately NOT
/// journaled — they are ephemeral UX, not durable state.
///
/// `seq` is monotonic PER DOCUMENT (assigned by lib/agent/event-journal.ts);
/// replay/resume reads are `WHERE seq > ? ORDER BY seq`. The read API is
/// GET /api/documents/[documentId]/events?afterSeq=N. Boot-time recovery
/// (lib/agent/boot-recovery.ts) scans for tool_call_start events without a
/// matching tool_call_end and appends synthetic `tool_call_interrupted`
/// observations so a future resume has an honest context.
model AgentEvent {
  id         String   @id @default(cuid())
  /// The shared document this event belongs to.
  documentId String
  /// Monotonic per-document sequence number (journal watermark).
  seq        Int
  /// Event discriminator: 'patch' | 'agent:tool_call_start' |
  /// 'agent:tool_call_end' | 'agent:turn_end' | 'agent:turn_cancelled' |
  /// 'agent:error' | 'agent:stuck' | … (mirrors the SyncEvent type union
  /// VERBATIM — lifecycle types carry the 'agent:' prefix — plus 'patch' for
  /// canvas mutations and synthetic 'agent:tool_call_interrupted' /
  /// 'patch_dropped' audit rows).
  type       String
  /// Tool-call correlation id (patches + tool lifecycle events).
  toolCallId String?
  /// JSON-serialized event payload (patch + toolCallId, or the SyncEvent).
  payload    String
  createdAt  DateTime @default(now())

  @@unique([documentId, seq])
  @@index([documentId, createdAt])
  @@index([documentId, type])
  @@index([type, createdAt])
}

/// Phase B replication core (R1): per-(document, client) exactly-once clock
/// for USER canvas patches — Replicache's `lastMutationID` rule. Every user
/// patch the relay accepts is journaled as a `user_patch` AgentEvent row AND
/// stamped here; a retried/replayed mutation with `clientMutationId <=
/// lastMutationId` is answered `duplicate` instead of double-applying, and a
/// gap (`> lastMutationId + 1`) is rejected so out-of-order flushes surface
/// instead of silently reordering the append-only canvas. Served read-side
/// by the events API (`lastMutationIDChanges`) and the agent status route so
/// reconnecting clients can prune their offline outbox and re-anchor their
/// mutation counter.
model MutationClock {
  id             String   @id @default(cuid())
  documentId     String
  clientId       String
  lastMutationId Int
  updatedAt      DateTime @updatedAt

  @@unique([documentId, clientId])
  @@index([documentId])
}

// ---- Phase 3: Server-side session persistence -------------------------------
//
// These models store chat sessions, messages, runs, and snapshots server-side
// (in SQLite via Prisma) so they survive browser clears and can sync across
// devices. The client's localStorage remains as a fast cache; the server is
// the source of truth.
//
// The session format is compatible with the pi-agent SDK's serializeConversation()
// output — sessions can be exported/imported in the standard JSONL format.

/// A chat session — a conversation context attached to one shared canvas
/// document (Figma/Cursor model: multiple chats mutate the same canvas).
/// Analogous to a ChatGPT "conversation" scoped to a document.
model Session {
  id         String   @id @default(cuid())
  /// The shared document this conversation is attached to.
  documentId String
  /// Display title (auto-generated from the first prompt or user-set).
  title      String   @default("Untitled")
  /// 'active' | 'archived'
  status     String   @default("active")
  /// Whether the session is pinned to the top of the list.
  pinned     Boolean  @default(false)
  /// Run count (denormalized for quick display).
  runCount   Int      @default(0)
  /// Total tool calls across all runs (denormalized).
  toolCallCount Int   @default(0)
  /// ISO timestamp of last activity.
  lastOpenedAt String @default("")
  /// For fork tracking — the parent session ID if this session was forked.
  parentSessionId String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   SessionMessage[]
  runs       SessionRun[]

  @@index([documentId])
  @@index([status])
}

/// A message in a session — either user prompt or agent response.
model SessionMessage {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// 'user' | 'assistant'
  role       String
  /// The text content of the message.
  content    String   @default("")
  /// 'streaming' | 'complete' | 'error' | 'cancelled'
  status     String   @default("complete")
  /// Error message (if status = 'error').
  error      String?
  /// Run this message belongs to.
  runId      String?
  /// JSON array of the turn's canvas-mutation records
  /// ([{ op, count, summary }, …] — see lib/agent/turn-diff.ts). Rolled up
  /// into the "+12 −3 ~5" diff summary card on the client. Assistant
  /// messages only; null/empty = no tracked changes.
  diffSummary String?
  /// Creation order.
  createdAt  DateTime @default(now())

  attachments SessionAttachment[]

  @@index([sessionId])
}

/// An image attachment on a user message (paste / paperclip / drop /
/// canvas snapshot). Persisted server-side alongside the localStorage cache
/// so history survives browser clears and syncs across devices.
///
/// The client downscales to ≤1280px + re-encodes as JPEG/PNG BEFORE upload
/// (lib/agent/attachments.ts), so `data` (raw base64, no data: prefix) is
/// bounded at ~1.1MB per row. The attachment id is the CLIENT-generated id
/// (img_…) — upserts are idempotent, so re-syncing never duplicates rows.
model SessionAttachment {
  id        String   @id
  messageId String
  message   SessionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Original file name (display only).
  name      String
  /// e.g. "image/jpeg" | "image/png".
  mimeType  String
  /// Decoded byte size (informational).
  sizeBytes Int      @default(0)
  /// Base64 image payload (no data: URL prefix).
  data      String
  createdAt DateTime @default(now())

  @@index([messageId])
}

/// A run — one execution of the agent (one prompt → tool calls → response).
model SessionRun {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// The user prompt that triggered this run.
  prompt     String
  /// 'queued' | 'in_progress' | 'completed' | 'failed' | 'cancelled'
  status     String   @default("queued")
  /// Error message (if status = 'failed').
  errorMessage String?
  /// Number of tool calls in this run.
  toolCallCount Int    @default(0)
  /// Tool call records (JSON array of { name, args, result, success, durationMs }).
  toolCalls  String   @default("[]")
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

/// A canvas snapshot — point-in-time capture of a DOCUMENT (shared canvas
/// model). Keyed by documentId; sessionId/messageId/runId are provenance for
/// which chat's turn produced the capture. The document timeline is shared
/// across every chat on the canvas.
model DocumentSnapshot {
  id         String   @id @default(cuid())
  /// The shared document this snapshot belongs to.
  documentId String
  /// Provenance: the chat whose turn produced this capture (nullable).
  sessionId  String?
  /// Provenance: the chat message whose turn produced this capture.
  messageId  String?
  /// Provenance: the agent run that produced this capture.
  runId      String?
  /// JSON-serialized CanvasDocument at capture time.
  document   String
  /// 'turn_end' | 'manual' | 'fork' | 'restore'
  source     String   @default("turn_end")
  /// Node count for quick display in the history panel.
  nodeCount  Int      @default(0)
  /// Optional user/system label.
  label      String?
  /// Whether the user marked this snapshot as a keeper.
  bookmarked Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([sessionId])
}
