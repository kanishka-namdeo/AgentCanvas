{
  "version": "1.0.0",
  "defaultPack": "shadcn-default",
  "packs": [
    {
      "name": "shadcn-default",
      "version": "1.0.0",
      "description": "Indigo, neutral, editorial. v0's defaults — Radix primitives styled with Tailwind. Best for new Next.js fullstack apps.",
      "palette": {
        "primary": "#1e3a5f",
        "background": "#fafafa",
        "accent": "#3b82f6",
        "text": "#0a0a0a"
      },
      "tokens": "tokens.css",
      "dependencies": [
        { "package": "tailwindcss", "min": "3.4.0" },
        { "package": "@radix-ui/react-dialog", "min": "1.0.5" },
        { "package": "class-variance-authority", "min": "0.7.0" },
        { "package": "lucide-react", "min": "0.300.0" }
      ],
      "importMap": {
        "Button": "@/components/ui/button",
        "Input": "@/components/ui/input",
        "Card": "@/components/ui/card",
        "Dialog": "@/components/ui/dialog",
        "Table": "@/components/ui/table",
        "Toast": "@/components/ui/sonner",
        "Tabs": "@/components/ui/tabs",
        "Avatar": "@/components/ui/avatar"
      },
      "fontStack": {
        "body": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "heading": "Inter, system-ui, -apple-system, sans-serif",
        "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
      },
      "bestFor": ["nextjs", "fullstack", "dashboard", "saas", "docs"]
    },
    {
      "name": "vercel-geist",
      "version": "1.0.0",
      "description": "Black, white, ultra-minimalist. Vercel's Geist design language — strict monochrome, mono-font accents, zero rounded corners.",
      "palette": {
        "primary": "#000000",
        "background": "#ffffff",
        "accent": "#0070f3",
        "text": "#111111"
      },
      "tokens": "tokens.css",
      "dependencies": [
        { "package": "geist", "min": "1.3.0" },
        { "package": "tailwindcss", "min": "3.4.0" }
      ],
      "importMap": {
        "Button": "geist/button",
        "Input": "geist/input",
        "Card": "geist/card",
        "Dialog": "geist/dialog",
        "Table": "geist/table",
        "Toast": "geist/sonner",
        "Tabs": "geist/tabs",
        "Avatar": "geist/avatar"
      },
      "fontStack": {
        "body": "'Geist Sans', system-ui, sans-serif",
        "heading": "'Geist Sans', system-ui, sans-serif",
        "mono": "'Geist Mono', ui-monospace, monospace"
      },
      "bestFor": ["minimal", "brand", "nextjs", "fullstack"]
    },
    {
      "name": "mantine-default",
      "version": "1.0.0",
      "description": "Warm gray, dense, feature-rich. Mantine's runtime library with AppShell, Dates, Notifications. Best for enterprise dashboards.",
      "palette": {
        "primary": "#1a1b1e",
        "background": "#fafafa",
        "accent": "#228be6",
        "text": "#1a1b1e"
      },
      "tokens": "tokens.css",
      "dependencies": [
        { "package": "@mantine/core", "min": "7.7.0" },
        { "package": "@mantine/hooks", "min": "7.7.0" },
        { "package": "@mantine/notifications", "min": "7.7.0" }
      ],
      "importMap": {
        "Button": "@mantine/core",
        "Input": "@mantine/core",
        "Card": "@mantine/core",
        "Dialog": "@mantine/core",
        "Table": "@mantine/core",
        "Toast": "@mantine/notifications",
        "Tabs": "@mantine/core",
        "Avatar": "@mantine/core"
      },
      "fontStack": {
        "body": "'Inter', system-ui, sans-serif",
        "heading": "'Inter', system-ui, sans-serif",
        "mono": "'JetBrains Mono', ui-monospace, monospace"
      },
      "bestFor": ["enterprise", "dashboard", "fullstack"]
    }
  ]
}
