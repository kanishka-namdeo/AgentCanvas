# ---------------------------------------------------------------------------
# co-canvas — environment template
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Prisma datasource URL.
# SQLite (default, dev): file path relative to the project root.
DATABASE_URL="file:./db/custom.db"
# z.ai sandbox: use the ABSOLUTE path instead — the sandbox exports DATABASE_URL
# globally and its boot script rewrites .env to
# DATABASE_URL="file:/home/z/my-project/db/custom.db" on every start.
# See docs/zai-sandbox-setup.md.

# PostgreSQL (optional, prod):
# DATABASE_URL="postgresql://user:password@localhost:5432/cocanvas?schema=public"

# Node runtime mode.
NODE_ENV="development"

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# The app's DEFAULT inference endpoint is a custom OpenAI-compatible endpoint
# (provider 'custom'):
#   base URL: https://irhnglwoxe.a.pinggy.link/v1
#   API key:  123456
#   model:    kimi-k2-5
# These defaults live in src/lib/settings/types.ts (DEFAULT_SETTINGS) and are
# user-tunable in Settings → LLM provider — nothing needs to be set here.
#
# The env keys below are only fallbacks for NON-default providers (the legacy
# runner path reads them when settings carry no API key). Inside the z.ai
# sandbox, `z-ai-web-dev-sdk` also auto-resolves credentials for the 'zai'
# provider — no API key needed for that provider.
#
# ZAI_API_KEY="your_zai_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"
